server {
    listen 80;
    listen [::]:80;
    server_name ${SERVER_NAME};
    access_log off;

    location ^~ /.well-known/acme-challenge/ {
        root ${ACME_WEBROOT};
        default_type text/plain;
        try_files $$uri =404;
    }
    location / {
        return 308 https://${SERVER_NAME}:${PUBLIC_PORT}$$request_uri;
    }
}

server {
    listen ${PUBLIC_PORT} ssl;
    listen [::]:${PUBLIC_PORT} ssl;
    server_name ${SERVER_NAME};
    ssl_certificate ${CERTIFICATE_PATH}/fullchain.pem;
    ssl_certificate_key ${CERTIFICATE_PATH}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:NanobananaTLS:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # Source URLs carry signed tokens; keep them out of access logs.
    access_log off;
    client_max_body_size 100m;

    location / {
        proxy_pass http://127.0.0.1:${BACKEND_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $$http_host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $$proxy_add_x_forwarded_for;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 900s;
        proxy_send_timeout 900s;
    }
}
