# Generated by deploy/configure_public_source.py. Do not install this template
# directly; placeholders are replaced from video.cupsy.source_base_url.
server {
    listen 80;
    listen [::]:80;
    server_name ${SERVER_NAME};

    access_log off;

    location ^~ /.well-known/acme-challenge/ {
        root ${ACME_WEBROOT};
        default_type text/plain;
        try_files $$uri =404;
    }

    location / {
        return 404;
    }
}

server {
    listen ${PUBLIC_PORT} ssl;
    listen [::]:${PUBLIC_PORT} ssl;
    server_name ${SERVER_NAME};

    ssl_certificate ${CERTIFICATE_PATH}/fullchain.pem;
    ssl_certificate_key ${CERTIFICATE_PATH}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:CupsyTLS:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # Signed source URLs contain bearer-like tokens and must not enter logs.
    access_log off;

    location ^~ /api/cupsy/source/ {
        proxy_pass http://127.0.0.1:${BACKEND_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $$host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $$proxy_add_x_forwarded_for;
        proxy_buffering off;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }

    location / {
        return 404;
    }
}
